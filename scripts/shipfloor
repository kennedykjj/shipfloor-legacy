#!/usr/bin/env bash
# shipfloor: installs the factory scripts and manages the projects the dispatcher serves.
#   install [--force]             copy scripts and templates to ~/.shipfloor/factory
#   doctor                        check tools, the installed copy and every project's config
#   add <repo> [--worktrees DIR]  register a local clone whose origin/main has .shipfloor/factory.yml
#   remove <slug> | list | pause [slug] | resume [slug] | setup-board <slug> | metrics <slug>
#   pool [set <n> | stage <stage> <n> | stacks <n>]  runs at once on this machine, per stage, and stack slots
#   clean <slug>                  remove what cards left under tmp/ (the dispatcher does it every cycle)
#   accept <slug> <n> <reason>    owner only: take card <n>'s acceptance tests as they stand (acceptance-intact)
#   weight <slug> <n> <light|standard|heavy>  owner only: card <n>'s weight, in Spec Review (the model its runs take)
#   dashboard [--port N] [--no-open] [--token T]  local dashboard: pool, runs, logs, cost per card, reviews
set -uo pipefail
HERE="${0%[/\\]*}"; [ "$HERE" != "$0" ] || HERE=.; HERE="$(cd "$HERE" && pwd)"  # no dirname: one process less per start
source "$HERE/lib/project.sh"
REGISTRY="$SHIPFLOOR_HOME/registry.tsv"
INSTALLED="$SHIPFLOOR_HOME/factory"

die() { echo "shipfloor: $1" >&2; exit "${2:-1}"; }
entry() { [ -f "$REGISTRY" ] && awk -F'\t' -v s="$1" '$1==s' "$REGISTRY"; }
use() {  # use <slug>: export that project's settings or fail
  local line; line="$(entry "$1")"; [ -n "$line" ] || die "no project '$1' (shipfloor list)"
  local slug repo wt main; IFS=$'\t' read -r slug repo wt main <<< "$line"
  shipfloor_use "$slug" "$repo" "$wt" "$main"
}
source_dir() {  # the plugin checkout this copy came from
  if [ -f "$HERE/.source" ]; then cat "$HERE/.source"; else (cd "$HERE/.." && pwd); fi
}

put_file() {  # put_file <from> <to>: sets PUT to same | added | replaced | failed; copy beside the target, then rename over it
  local from="$1" to="$2" tmp="${2%/*}/.${2##*/}.install-tmp"
  PUT=same
  if [ -f "$to" ]; then cmp -s "$from" "$to" && return 0; PUT=replaced; else PUT=added; fi
  mkdir -p "${to%/*}"
  # cp -p keeps the mode (the execute bit) on the temporary file; mv gets the target last
  if cp -p "$from" "$tmp" && mv -f "$tmp" "$to"; then return 0; fi
  rm -f "$tmp"; PUT=failed
}

main_of() {  # main_of <clone>: its main branch, as cmd_add reads it
  local m; m="$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"; m="${m#origin/}"; echo "${m:-main}"
}
SRC_REASONS=()
source_state() {  # source_state <src>: why the clone is not a clean, current main (SRC_REASONS: "reason<TAB>what to do"), and what it read
  local src="$1" ahead behind n=0 f list="" tab=$'\t'
  SRC_GIT=0; SRC_REASONS=(); [ -e "$src/.git" ] || return 0  # -e: in a worktree .git is a file
  SRC_GIT=1
  SRC_MAIN="$(main_of "$src")"
  SRC_COMMIT="$(git -C "$src" rev-parse HEAD)"; SRC_BRANCH="$(git -C "$src" symbolic-ref -q --short HEAD)"
  if [ -z "$SRC_BRANCH" ]; then SRC_REASONS+=("on a detached HEAD at $(git -C "$src" rev-parse --short HEAD), not $SRC_MAIN${tab}git -C $src checkout $SRC_MAIN")
  elif [ "$SRC_BRANCH" != "$SRC_MAIN" ]; then SRC_REASONS+=("on branch $SRC_BRANCH, not $SRC_MAIN${tab}git -C $src checkout $SRC_MAIN"); fi
  while IFS= read -r f; do
    n=$((n+1)); [ "$n" -le 10 ] && list="${list:+$list, }${f:3}"
  done < <(git -C "$src" -c core.quotePath=false status --porcelain --untracked-files=no)
  [ "$n" -gt 10 ] && list="$list, and $((n-10)) more"
  [ "$n" -gt 0 ] && SRC_REASONS+=("$n tracked file(s) with uncommitted changes: $list${tab}commit or stash them")
  if GIT_TERMINAL_PROMPT=0 git -C "$src" fetch -q origin "$SRC_MAIN" 2>/dev/null; then
    read -r ahead behind < <(git -C "$src" rev-list --left-right --count "HEAD...origin/$SRC_MAIN")
    [ "$behind" -gt 0 ] && SRC_REASONS+=("$behind commit(s) behind origin/$SRC_MAIN${tab}git -C $src pull")
    [ "$ahead" -gt 0 ] && SRC_REASONS+=("$ahead commit(s) ahead of origin/$SRC_MAIN${tab}they are not merged; push and merge them first")
  else SRC_REASONS+=("could not check the remote (git fetch origin $SRC_MAIN failed)${tab}check the network and the origin remote"); fi
  return 0
}

cmd_install() {
  local src force=0 r kind=verified; src="$(source_dir)"
  while [ $# -gt 0 ]; do
    case "$1" in --force) force=1; shift ;; *) die "usage: shipfloor install [--force]" 2 ;; esac
  done
  [ -f "$src/scripts/gate.sh" ] || die "cannot find the plugin at $src"
  source_state "$src"
  if [ ${#SRC_REASONS[@]} -gt 0 ]; then
    if [ "$force" = 0 ]; then
      echo "shipfloor: not installing from $src:" >&2
      for r in "${SRC_REASONS[@]}"; do echo "  ${r%%$'\t'*}: ${r#*$'\t'}" >&2; done
      echo "install anyway: shipfloor install --force" >&2; exit 1
    fi
    kind=forced
  fi
  mkdir -p "$INSTALLED" "$SHIPFLOOR_HOME/projects" "$SHIPFLOOR_HOME/logs"
  local f nrep=0 nadd=0 ndel=0 nbad=0 d
  # every file goes in by rename, so a running script keeps its old inode and a reader never sees half a file
  find "$INSTALLED" -type f -name '.*.install-tmp' -exec rm -f {} + 2>/dev/null  # leftovers of a killed install
  while IFS= read -r f; do
    put_file "$src/scripts/$f" "$INSTALLED/$f"
    case "$PUT" in replaced) nrep=$((nrep+1)) ;; added) nadd=$((nadd+1)) ;; failed) nbad=$((nbad+1)); echo "shipfloor: could not replace ${f#./}" >&2 ;; esac
  done < <(cd "$src/scripts" && find . \( -path ./test -o -name __pycache__ \) -prune -o -type f ! -name '*.pyc' -print)
  while IFS= read -r f; do
    put_file "$src/templates/$f" "$INSTALLED/templates/$f"
    case "$PUT" in replaced) nrep=$((nrep+1)) ;; added) nadd=$((nadd+1)) ;; failed) nbad=$((nbad+1)); echo "shipfloor: could not replace templates/${f#./}" >&2 ;; esac
  done < <(cd "$src/templates" && find . -type f -print)
  mkdir -p "$INSTALLED/templates"
  # drop what the plugin no longer ships (a script or template it renamed or removed): scripts, then templates
  while IFS= read -r f; do
    [ -f "$src/scripts/$f" ] || { if rm -f "$INSTALLED/$f" && [ ! -e "$INSTALLED/$f" ]; then ndel=$((ndel+1)); else nbad=$((nbad+1)); echo "shipfloor: could not replace ${f#./}" >&2; fi; }
  done < <(cd "$INSTALLED" && find . -type f ! -name .source ! -name .origin ! -name '.*.install-tmp' ! -path './templates/*' -print)
  while IFS= read -r f; do
    [ -f "$src/templates/$f" ] || { if rm -f "$INSTALLED/templates/$f" && [ ! -e "$INSTALLED/templates/$f" ]; then ndel=$((ndel+1)); else nbad=$((nbad+1)); echo "shipfloor: could not replace templates/${f#./}" >&2; fi; }
  done < <(cd "$INSTALLED/templates" && find . -type f ! -name '.*.install-tmp' -print)
  while IFS= read -r d; do rmdir "$d" 2>/dev/null; done < <(find "$INSTALLED" -mindepth 1 -depth -type d ! -path "$INSTALLED/templates")  # only the empty ones go
  # .source last and only when all is in place: doctor then never says "matches" for a half copy
  if [ "$nbad" = 0 ]; then  # by rename too: other commands read it while an install runs
    echo "$src" > "$SHIPFLOOR_HOME/.source.new"; put_file "$SHIPFLOOR_HOME/.source.new" "$INSTALLED/.source"; rm -f "$SHIPFLOOR_HOME/.source.new"
    [ "$PUT" = failed ] && { nbad=$((nbad+1)); echo "shipfloor: could not replace .source" >&2; }
    if [ "$SRC_GIT" = 1 ]; then printf '%s\t%s\t%s\n' "$SRC_COMMIT" "${SRC_BRANCH:-detached}" "$kind" > "$INSTALLED/.origin"; else rm -f "$INSTALLED/.origin"; fi
  fi
  echo "installed $src → $INSTALLED: $nrep replaced, $nadd added, $ndel removed"
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) echo "next: shipfloor add <repo>; then (Windows) powershell -File \"$src/installer/install-dispatcher.ps1\"" ;;
    *) echo "next: shipfloor add <repo>; then bash \"$src/installer/install-dispatcher.sh\"" ;;
  esac
  if [ "$kind" = forced ]; then
    local why=""; for r in "${SRC_REASONS[@]}"; do why="${why:+$why; }${r%%$'\t'*}"; done
    echo "WARN installed copy is not a verified $SRC_MAIN: branch ${SRC_BRANCH:-detached}, commit $(git -C "$src" rev-parse --short HEAD) ($why)"
  fi
  [ "$nbad" = 0 ]
}

cmd_doctor() {
  local bad=0 t src agents=() line warned=0
  for t in git gh claude; do command -v "$t" >/dev/null && echo "ok   $t" || { echo "FAIL $t not found"; bad=1; }; done
  if shipfloor_python -c 'import yaml' 2>/dev/null; then echo "ok   python + PyYAML"; else echo "FAIL python 3 with PyYAML (pip install pyyaml)"; bad=1; fi
  local pyv
  pyv="$(shipfloor_python -c 'import sys; print("%d.%d.%d" % sys.version_info[:3], int(sys.version_info >= (3, 11)))' 2>/dev/null | tr -d '\r')"
  case "$pyv" in
    *" 1") echo "ok   python ${pyv% *} (3.11 or later)" ;;
    *" 0") echo "FAIL python ${pyv% *} is too old: Shipfloor needs Python 3.11 or later (set FACTORY_PYTHON to one)"; bad=1 ;;
    *) echo "FAIL python 3.11 or later not found (set FACTORY_PYTHON to one)"; bad=1 ;;
  esac
  gh auth status >/dev/null 2>&1 && echo "ok   gh authenticated" || { echo "FAIL gh auth login"; bad=1; }
  src="$(source_dir)"
  if [ ! -d "$INSTALLED" ]; then echo "FAIL not installed (shipfloor install)"; bad=1
  elif diff -rq -x test -x .source -x .origin -x __pycache__ "$src/scripts" "$INSTALLED" -x templates >/dev/null 2>&1 \
       && diff -rq "$src/templates" "$INSTALLED/templates" >/dev/null 2>&1; then echo "ok   installed copy matches $src"
  else echo "WARN installed copy differs from $src (shipfloor install)"; fi
  local dst dkind
  dkind="$(bash "$src/installer/install-dispatcher.sh" --status 2>/dev/null)"; dst=$?
  case $dst in
    0) echo "ok   dispatcher registered (${dkind#registered: })" ;;
    1) echo "WARN no dispatcher registered; run: bash $src/installer/install-dispatcher.sh" ;;
  esac
  if [ -d "$INSTALLED" ]; then
    local oc="" ob="" ov="" mb; mb="$(main_of "$src")"
    [ -f "$INSTALLED/.origin" ] && IFS=$'\t' read -r oc ob ov < "$INSTALLED/.origin"
    case "$ov" in
      verified) echo "ok   installed from $ob at ${oc:0:7}" ;;
      forced) echo "WARN installed copy was forced from branch $ob at ${oc:0:7}, not a verified $mb (shipfloor install from a clean $mb)" ;;
      *) echo "WARN installed copy has no recorded commit (not a git clone, or installed before this check)" ;;
    esac
  fi
  local alert
  while IFS= read -r alert; do
    [ -n "$alert" ] && echo "WARN health: $alert (~/.shipfloor/logs/health-*.jsonl)"
  done < <(shipfloor_python "$(shipfloor_native "$HERE/shipfloor_health.py")" alerts --home "$(shipfloor_native "$SHIPFLOOR_HOME")" 2>/dev/null | tr -d '\r')
  if [ -s "$REGISTRY" ]; then
    local slug repo wt main
    while IFS=$'\t' read -r slug repo wt main; do
      [ -z "$slug" ] && continue
      ( shipfloor_use "$slug" "$repo" "$wt" "$main"; shipfloor_validate ) \
        && echo "ok   project $slug" || { echo "FAIL project $slug: invalid or missing config"; bad=1; continue; }
      ( shipfloor_use "$slug" "$repo" "$wt" "$main"
        IFS=$'\t' read -r lcode lfrom lname < <(FACTORY_LANGUAGE="" shipfloor_cfg language 2>/dev/null | tr -d '\r')
        [ -n "$lcode" ] && echo "ok   $slug: writes in $lname ($lcode), from $([ "$lfrom" = machine ] && echo "this machine" || echo "the repository")"
        stale="$(shipfloor_stale_tmp | wc -l | tr -d ' ')"
        [ "$stale" -gt 0 ] && echo "WARN $slug: $stale tmp dir(s) of finished cards; run: shipfloor clean $slug"
        if [ -s "$FACTORY_HOME/SKIPPED" ]; then
          IFS=$'\t' read -r since why < "$FACTORY_HOME/SKIPPED"
          echo "WARN $slug: the dispatcher skips it since $since: $why"
        fi
        if [ -e "$FACTORY_HOME/control/.git" ] && \
           [ "$(git -C "$FACTORY_HOME/control" rev-parse HEAD 2>/dev/null)" != "$(git -C "$FACTORY_REPO" rev-parse "origin/$FACTORY_MAIN" 2>/dev/null)" ]; then
          echo "WARN $slug: control checkout is behind origin/$FACTORY_MAIN; the next dispatcher cycle should move it (see ~/.shipfloor/logs/dispatcher.log if it does not)"
        fi
        r="$(shipfloor_cfg get project.repo)"; b="$(shipfloor_cfg get project.main)"
        strict="$(gh api "repos/$r/branches/$b/protection" --jq .required_status_checks.strict 2>&1)"
        if [ "$strict" = true ]; then echo "ok   $slug: $b requires up-to-date branches"
        else echo "WARN $slug: $b does not require up-to-date branches (${strict##*: }); a hand merge can race the deploy"; fi )
      mapfile -t -O "${#agents[@]}" agents < <( shipfloor_use "$slug" "$repo" "$wt" "$main"
        for line in $(shipfloor_cfg layers --implementers); do shipfloor_cfg layer "$line" agent; done )
    done < "$REGISTRY"
  else echo "WARN no projects (shipfloor add <repo>)"; fi
  while IFS= read -r line; do
    [ -n "$line" ] && { echo "WARN models: $line"; warned=1; }
  done < <(shipfloor_machine models-check "${agents[@]}" 2>&1 | tr -d '\r')
  [ "$warned" -eq 1 ] || echo "ok   models"
  return $bad
}

cmd_add() {
  local repo="${1:-}" wt="" main=""; shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktrees) wt="${2:-}"; shift 2 ;;
      --main) main="${2:-}"; shift 2 ;;
      *) die "add: unknown option $1" 2 ;;
    esac
  done
  [ -n "$repo" ] || die "usage: shipfloor add <repo> [--worktrees DIR] [--main BRANCH]" 2
  repo="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || die "$repo is not a git repository"
  [ -n "$main" ] || main="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"
  [ -n "$main" ] || main=main
  git -C "$repo" fetch -q origin "$main" || die "cannot fetch origin/$main in $repo"
  local cfg slug; cfg="$(mktemp)"
  local p; p="$(shipfloor_config_path "$(shipfloor_native "$repo")" "origin/$main")" || die "origin/$main has no .shipfloor/factory.yml"
  MSYS2_ARG_CONV_EXCL="*" git -C "$(shipfloor_native "$repo")" show "origin/$main:$p" > "$cfg" 2>/dev/null || die "cannot read $p on origin/$main"
  FACTORY_CONFIG="$cfg" shipfloor_validate || die "invalid $p on origin/$main"
  slug="$(FACTORY_CONFIG="$cfg" shipfloor_cfg get project.name)"
  local current; current="$(entry "$slug" | cut -f2)"
  if [ -n "$current" ] && [ "$(git_common "$current")" != "$(git_common "$repo")" ]; then
    die "project '$slug' is already registered for $current"
  fi
  local home="$SHIPFLOOR_HOME/projects/$slug"
  [ -n "$wt" ] || wt="$(entry "$slug" | cut -f3)"  # adding again keeps the registered worktrees
  [ -n "$wt" ] || wt="$home/wt"
  mkdir -p "$home" "$wt"
  if [ ! -e "$home/control/.git" ]; then git -C "$repo" worktree add -q --detach "$home/control" "origin/$main" || die "cannot create $home/control"
  else git -C "$home/control" checkout -q --detach "origin/$main" || die "cannot move $home/control to origin/$main"; fi
  shipfloor_use "$slug" "$repo" "$wt" "$main"
  shipfloor_snapshot || die "cannot read .shipfloor/factory.yml from $home/control"
  { [ -f "$REGISTRY" ] && awk -F'\t' -v s="$slug" '$1!=s' "$REGISTRY"; printf '%s\t%s\t%s\t%s\n' "$slug" "$repo" "$wt" "$main"; } > "$REGISTRY.tmp"
  mv "$REGISTRY.tmp" "$REGISTRY"
  echo "registered $slug ($repo, worktrees in $wt)"
}

cmd_remove() {
  use "${1:-}"
  git -C "$FACTORY_REPO" worktree remove --force "$FACTORY_HOME/control" 2>/dev/null || rm -rf "$FACTORY_HOME/control"
  awk -F'\t' -v s="$1" '$1!=s' "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
  echo "removed $1 (logs and reports stay in $FACTORY_HOME)"
}

cmd_list() {
  [ -s "$REGISTRY" ] || { echo "no projects"; return 0; }
  [ -e "$SHIPFLOOR_HOME/PAUSE" ] && echo "(all paused)"
  local slug repo wt main state
  while IFS=$'\t' read -r slug repo wt main; do
    [ -z "$slug" ] && continue
    state=active; [ -e "$SHIPFLOOR_HOME/projects/$slug/PAUSE" ] && state=paused
    printf '%s\t%s\t%s\t%s\n' "$slug" "$state" "$repo" "$wt"
  done < "$REGISTRY"
}

cmd_pause() {
  if [ -z "${1:-}" ]; then mkdir -p "$SHIPFLOOR_HOME"; touch "$SHIPFLOOR_HOME/PAUSE"; return 0; fi
  use "$1"; mkdir -p "$FACTORY_HOME"; touch "$FACTORY_HOME/PAUSE"
}
cmd_resume() {
  if [ -z "${1:-}" ]; then rm -f "$SHIPFLOOR_HOME/PAUSE"; return 0; fi
  use "$1"; rm -f "$FACTORY_HOME/PAUSE"
}

cmd_pool() {  # pool | pool set <n> | pool stage <stage> <n>: the machine-wide agent pool
  case "${1:-}" in
    "")
      local out line stage n lock
      out="$(shipfloor_machine show)" || return $?
      while IFS= read -r line; do
        if [[ "$line" =~ ^\ \ ([a-z]+):\  ]]; then
          stage="${BASH_REMATCH[1]}"; n=0
          for lock in "$SHIPFLOOR_HOME"/projects/*/locks/"$stage"-*.lock; do [ -d "$lock" ] && n=$(( n + 1 )); done
          [ "$n" -gt 0 ] && line="$line ($n running)"
        fi
        echo "$line"
      done <<< "$out"
      local first; first="$(awk -F'\t' 'NF{print $1; exit}' "$REGISTRY" 2>/dev/null)"
      [ -n "$first" ] && ( use "$first"; cd "$FACTORY_HOME" && bash "$HERE/gate.sh" stack status ) | while IFS=$'\t' read -r k st owner held why; do
        if [ "$k" = queue ]; then [ "$st" -gt 0 ] && echo "  queue: $st waiting"
        else echo "  slot $k: $st${owner:+ $owner}$( [ "$st" = free ] || echo " ($(( held / 60 ))m)")${why:+ — $why}"; fi
      done ;;
    set) shipfloor_machine set pool "${2:-}" ;;
    stage) shipfloor_machine set "stages.${2:-}" "${3:-}" ;;
    stacks) shipfloor_machine set stacks "${2:-}" ;;
    *) die "usage: shipfloor pool [set <n> | stage <refine|develop|validate|deploy> <n> | stacks <n>]" 2 ;;
  esac
}

cmd_dashboard() {  # dashboard [--port N] [--no-open] [--token T]: serves the local dashboard until Ctrl+C
  SHIPFLOOR_BASH="$(shipfloor_native "$BASH")" shipfloor_python "$(shipfloor_native "$HERE/dashboard.py")" \
    --home "$(shipfloor_native "$SHIPFLOOR_HOME")" "$@"
}

cmd_accept() {  # accept <slug> <n> <reason...>: the owner reviewed how card <n>'s acceptance files changed after the QA commit
  # (a merge from main resolved by hand, a setup line main forced, a stub deleted) and takes them as they stand. The gate
  # then passes those exact contents; any later edit blocks again. Recorded in the project's home.
  local slug="${1:-}" n="${2:-}"; shift 2 2>/dev/null || true
  local reason="$*" wt qa f blob key took=0
  [ -n "$slug" ] && [[ "$n" =~ ^[0-9]+$ ]] && [ -n "$reason" ] || die "usage: shipfloor accept <project> <n> <reason>" 2
  use "$slug"; wt="$FACTORY_WT_ROOT/$n"
  [ -e "$wt/.git" ] || die "no worktree for card $n at $wt"
  qa="$(bash "$HERE/gate.sh" -C "$wt" qa-commit "$n" 2>/dev/null)"
  [ -n "$qa" ] || die "no QA commit (\"acceptance tests for #$n\") on $(git -C "$wt" rev-parse --abbrev-ref HEAD)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    git -C "$wt" diff --quiet "$qa" HEAD -- "$f" && continue  # untouched since QA
    blob="$(git -C "$wt" rev-parse -q --verify "HEAD:$f")" || blob=deleted  # a stub the real code replaced
    key="$blob"  # the card's own edit when the gate can isolate it: a later merge from main elsewhere in the file keeps the record
    [ "$blob" = deleted ] || key="$(bash "$HERE/gate.sh" -C "$wt" acceptance-own "$qa" "$f" 2>/dev/null)" || key="$blob"
    grep -qF -e "$f"$'	'"$key"$'	' -e "$f"$'	'"$blob"$'	' "$FACTORY_HOME/accepted.tsv" 2>/dev/null && continue  # already accepted as it stands
    [ -z "$(git -C "$wt" status --porcelain -- "$f")" ] || die "$f has uncommitted changes in $wt"
    printf '%s\t%s\t#%s\t%s\t%s\n' "$f" "$key" "$n" "$(date -Is)" "$(printf '%s' "$reason" | tr '\t\r\n' '   ')" >> "$FACTORY_HOME/accepted.tsv"
    if [ "$blob" = deleted ]; then echo "accepted the deletion of $f"; else echo "accepted $f at ${blob:0:12}"; fi; took=1
  done < <(git -C "$wt" -c core.quotePath=false show --name-only --format= --diff-filter=d "$qa")
  [ "$took" = 1 ] || echo "nothing to accept: acceptance-intact already passes for card $n"
}

cmd_weight() {  # weight <slug> <n> <light|standard|heavy>: the owner sets card <n>'s weight in its spec header, from Spec Review
  # One commit on the card's branch, pushed; the review page is not rebuilt, so the owner's marks stay.
  local slug="${1:-}" n="${2:-}" w="${3:-}" wt spec branch d pid old tmp out
  [ -n "$slug" ] && [[ "$n" =~ ^[0-9]+$ ]] && [ $# -eq 3 ] || die "usage: shipfloor weight <project> <n> <light|standard|heavy>" 2
  case "$w" in light|standard|heavy) ;; *) die "'$w' is not a weight (light, standard, heavy)" 2 ;; esac
  use "$slug"; wt="$FACTORY_WT_ROOT/$n"
  [ "$(bash "$HERE/board.sh" status "$n" 2>/dev/null)" = "Spec Review" ] || die "the card is no longer in Spec Review." 3
  for d in "$FACTORY_HOME"/locks/[a-z]*-"$n".lock; do
    [ -d "$d" ] || continue; pid=""; read -r pid _ < "$d/info" 2>/dev/null
    { [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; } && die "a run is working on card $n now; try again when it ends" 3
  done
  spec="$(shipfloor_card_spec "$n")"; [ -n "$spec" ] || die "no spec for card $n under $wt"
  branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD)"
  [ -z "$(git -C "$wt" status --porcelain -- "$spec")" ] || die "$spec has uncommitted changes"
  old="$(awk '/^## /{exit} /^\*\*Weight:\*\*/' "$spec" | tr -d '\r')"
  [ "$old" = "**Weight:** $w" ] && { echo "weight $w"; return 0; }
  # the one line, after the header's last **Field:** line (or before the first section); a second one goes
  tmp="$spec.weight-tmp"
  awk -v line="**Weight:** $w" '
    { rows[NR] = $0 }
    !sec && /^## / { sec = NR }
    !sec && /^\*\*[^*]+:\*\*/ && !/^\*\*Weight:\*\*/ { last = NR }
    END { at = last ? last : (sec ? sec - 1 : NR); done = 0
      if (at == 0) { print line; done = 1 }
      for (i = 1; i <= NR; i++) {
        if ((!sec || i < sec) && rows[i] ~ /^\*\*Weight:\*\*/) continue
        print rows[i]
        if (i == at && !done) { print line; done = 1 } } }' "$spec" > "$tmp" && mv -f "$tmp" "$spec" || { rm -f "$tmp"; die "could not write $spec"; }
  git -C "$wt" add -- "$spec" && git -C "$wt" commit -q -m "docs(${branch#feat/$n-}): weight $w for #$n" -- "$spec" || { git -C "$wt" checkout -q -- "$spec"; die "could not commit the weight"; }
  if ! out="$(git -C "$wt" push -q origin "HEAD:$branch" 2>&1)"; then
    git -C "$wt" reset -q --hard HEAD~1
    die "could not push $branch: $(printf '%s' "$out" | grep -m1 -E '^(fatal|error|remote|!)' || printf '%s' "$out" | head -1)"
  fi
  echo "weight $w"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install) cmd_install "$@" ;;
  doctor) cmd_doctor ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list ;;
  pool) cmd_pool "$@" ;;
  clean) use "${1:-}"; shipfloor_sweep_tmp | sed 's/^/removed /' ;;
  accept) cmd_accept "$@" ;;
  weight) cmd_weight "$@" ;;
  pause) cmd_pause "$@" ;;
  resume) cmd_resume "$@" ;;
  setup-board) use "${1:-}"; cd "$FACTORY_HOME/control" && exec bash "$HERE/setup-board.sh" ;;
  dashboard) cmd_dashboard "$@" ;;
  metrics) use "${1:-}"; exec bash "$HERE/metrics.sh" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
