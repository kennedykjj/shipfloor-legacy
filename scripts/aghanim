#!/usr/bin/env bash
# aghanim: installs the factory scripts and manages the projects the dispatcher serves.
#   install                       copy scripts and templates to ~/.aghanim/factory
#   doctor                        check tools, the installed copy and every project's config
#   add <repo> [--worktrees DIR]  register a local clone whose origin/main has .aghanim/factory.yml
#   remove <slug> | list | pause [slug] | resume [slug] | setup-board <slug> | metrics <slug>
#   pool [set <n> | stage <stage> <n>]  runs at once on this machine, and per stage
#   migrate-home [OLD]            move the old ~/.mylos home here (one-time, after the rename; legacy mylos)
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
source "$HERE/lib/project.sh"
REGISTRY="$AGHANIM_HOME/registry.tsv"
INSTALLED="$AGHANIM_HOME/factory"

die() { echo "aghanim: $1" >&2; exit "${2:-1}"; }
entry() { [ -f "$REGISTRY" ] && awk -F'\t' -v s="$1" '$1==s' "$REGISTRY"; }
use() {  # use <slug>: export that project's settings or fail
  local line; line="$(entry "$1")"; [ -n "$line" ] || die "no project '$1' (aghanim list)"
  local slug repo wt main; IFS=$'\t' read -r slug repo wt main <<< "$line"
  aghanim_use "$slug" "$repo" "$wt" "$main"
}
source_dir() {  # the plugin checkout this copy came from
  if [ -f "$HERE/.source" ]; then cat "$HERE/.source"; else (cd "$HERE/.." && pwd); fi
}

cmd_install() {
  local src; src="$(source_dir)"
  [ -f "$src/scripts/gate.sh" ] || die "cannot find the plugin at $src"
  mkdir -p "$INSTALLED" "$AGHANIM_HOME/projects" "$AGHANIM_HOME/logs"
  (cd "$src/scripts" && find . -path ./test -prune -o -type f -print) | while IFS= read -r f; do
    mkdir -p "$INSTALLED/$(dirname "$f")"; cp "$src/scripts/$f" "$INSTALLED/$f"
  done
  rm -rf "$INSTALLED/templates"; cp -r "$src/templates" "$INSTALLED/templates"
  echo "$src" > "$INSTALLED/.source"
  echo "installed $src → $INSTALLED"
  echo "next: aghanim add <repo>; then (Windows) powershell -File \"$src/installer/install-dispatcher.ps1\""
}

cmd_doctor() {
  local bad=0 t src
  for t in git gh claude; do command -v "$t" >/dev/null && echo "ok   $t" || { echo "FAIL $t not found"; bad=1; }; done
  if aghanim_python -c 'import yaml' 2>/dev/null; then echo "ok   python + PyYAML"; else echo "FAIL python 3 with PyYAML (pip install pyyaml)"; bad=1; fi
  gh auth status >/dev/null 2>&1 && echo "ok   gh authenticated" || { echo "FAIL gh auth login"; bad=1; }
  if [ -d "$HOME/.mylos" ] && [ ! -e "$AGHANIM_HOME" ]; then  # legacy mylos home
    echo "WARN found $HOME/.mylos from before the rename; run: aghanim migrate-home"
  fi
  src="$(source_dir)"
  if [ ! -d "$INSTALLED" ]; then echo "FAIL not installed (aghanim install)"; bad=1
  elif diff -rq -x test -x .source "$src/scripts" "$INSTALLED" -x templates >/dev/null 2>&1 \
       && diff -rq "$src/templates" "$INSTALLED/templates" >/dev/null 2>&1; then echo "ok   installed copy matches $src"
  else echo "WARN installed copy differs from $src (aghanim install)"; fi
  if [ -s "$REGISTRY" ]; then
    local slug repo wt main
    while IFS=$'\t' read -r slug repo wt main; do
      [ -z "$slug" ] && continue
      ( aghanim_use "$slug" "$repo" "$wt" "$main"; aghanim_validate ) \
        && echo "ok   project $slug" || { echo "FAIL project $slug: invalid or missing config"; bad=1; continue; }
      ( aghanim_use "$slug" "$repo" "$wt" "$main"
        r="$(aghanim_cfg get project.repo)"; b="$(aghanim_cfg get project.main)"
        strict="$(gh api "repos/$r/branches/$b/protection" --jq .required_status_checks.strict 2>&1)"
        if [ "$strict" = true ]; then echo "ok   $slug: $b requires up-to-date branches"
        else echo "WARN $slug: $b does not require up-to-date branches (${strict##*: }); a hand merge can race the deploy"; fi )
    done < "$REGISTRY"
  else echo "WARN no projects (aghanim add <repo>)"; fi
  return $bad
}

cmd_add() {
  local repo="${1:-}" wt="" main=""; shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktrees) wt="${2:-}"; shift 2 ;;
      --main) main="${2:-}"; shift 2 ;;
      *) die "add: unknown option $1" 2 ;;
    esac
  done
  [ -n "$repo" ] || die "usage: aghanim add <repo> [--worktrees DIR] [--main BRANCH]" 2
  repo="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || die "$repo is not a git repository"
  [ -n "$main" ] || main="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')"
  [ -n "$main" ] || main=main
  git -C "$repo" fetch -q origin "$main" || die "cannot fetch origin/$main in $repo"
  local cfg slug; cfg="$(mktemp)"
  local p; p="$(aghanim_config_path "$(aghanim_native "$repo")" "origin/$main")" || die "origin/$main has no .aghanim/factory.yml"
  MSYS2_ARG_CONV_EXCL="*" git -C "$(aghanim_native "$repo")" show "origin/$main:$p" > "$cfg" 2>/dev/null || die "cannot read $p on origin/$main"
  FACTORY_CONFIG="$cfg" aghanim_validate || die "invalid $p on origin/$main"
  slug="$(FACTORY_CONFIG="$cfg" aghanim_cfg get project.name)"
  local current; current="$(entry "$slug" | cut -f2)"
  if [ -n "$current" ] && [ "$(git_common "$current")" != "$(git_common "$repo")" ]; then
    die "project '$slug' is already registered for $current"
  fi
  local home="$AGHANIM_HOME/projects/$slug"; [ -n "$wt" ] || wt="$home/wt"
  mkdir -p "$home" "$wt"
  if [ ! -e "$home/control/.git" ]; then git -C "$repo" worktree add -q --detach "$home/control" "origin/$main" || die "cannot create $home/control"; fi
  aghanim_use "$slug" "$repo" "$wt" "$main"
  aghanim_snapshot || die "cannot read .aghanim/factory.yml from $home/control"
  { [ -f "$REGISTRY" ] && awk -F'\t' -v s="$slug" '$1!=s' "$REGISTRY"; printf '%s\t%s\t%s\t%s\n' "$slug" "$repo" "$wt" "$main"; } > "$REGISTRY.tmp"
  mv "$REGISTRY.tmp" "$REGISTRY"
  echo "registered $slug ($repo, worktrees in $wt)"
}

cmd_remove() {
  use "${1:-}"
  git -C "$FACTORY_REPO" worktree remove --force "$FACTORY_HOME/control" 2>/dev/null || rm -rf "$FACTORY_HOME/control"
  awk -F'\t' -v s="$1" '$1!=s' "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
  echo "removed $1 (logs and reports stay in $FACTORY_HOME)"
}

cmd_list() {
  [ -s "$REGISTRY" ] || { echo "no projects"; return 0; }
  [ -e "$AGHANIM_HOME/PAUSE" ] && echo "(all paused)"
  local slug repo wt main state
  while IFS=$'\t' read -r slug repo wt main; do
    [ -z "$slug" ] && continue
    state=active; [ -e "$AGHANIM_HOME/projects/$slug/PAUSE" ] && state=paused
    printf '%s\t%s\t%s\t%s\n' "$slug" "$state" "$repo" "$wt"
  done < "$REGISTRY"
}

cmd_pause() {
  if [ -z "${1:-}" ]; then mkdir -p "$AGHANIM_HOME"; touch "$AGHANIM_HOME/PAUSE"; return 0; fi
  use "$1"; mkdir -p "$FACTORY_HOME"; touch "$FACTORY_HOME/PAUSE"
}
cmd_resume() {
  if [ -z "${1:-}" ]; then rm -f "$AGHANIM_HOME/PAUSE"; return 0; fi
  use "$1"; rm -f "$FACTORY_HOME/PAUSE"
}

cmd_pool() {  # pool | pool set <n> | pool stage <stage> <n>: the machine-wide agent pool
  case "${1:-}" in
    "")
      local out line stage n
      out="$(aghanim_machine show)" || return $?
      while IFS= read -r line; do
        stage="$(printf '%s' "$line" | sed -n 's/^  \([a-z]*\): .*/\1/p')"
        if [ -n "$stage" ]; then
          n="$(find "$AGHANIM_HOME/projects" -maxdepth 3 -type d -path "*/locks/$stage-*.lock" 2>/dev/null | wc -l | tr -d ' ')"
          [ "$n" -gt 0 ] && line="$line ($n running)"
        fi
        echo "$line"
      done <<< "$out" ;;
    set) aghanim_machine set pool "${2:-}" ;;
    stage) aghanim_machine set "stages.${2:-}" "${3:-}" ;;
    *) die "usage: aghanim pool [set <n> | stage <refine|develop|validate|deploy> <n>]" 2 ;;
  esac
}

cmd_migrate_home() {  # migrate-home [OLD]: move the legacy mylos home to $AGHANIM_HOME and relink its worktrees
  local old="${1:-$HOME/.mylos}" d  # legacy mylos home
  [ -d "$old" ] || die "nothing to migrate: $old does not exist"
  [ ! -e "$AGHANIM_HOME" ] || die "$AGHANIM_HOME already exists; move or remove it first"
  if [ -n "$(find "$old/locks" "$old"/projects/*/locks -mindepth 1 -maxdepth 1 -name '*.lock' 2>/dev/null)" ]; then
    die "runs in progress in $old (locks present); wait for them to end"
  fi
  mkdir -p "$(dirname "$AGHANIM_HOME")"
  mv "$old" "$AGHANIM_HOME" || die "cannot move $old to $AGHANIM_HOME"
  for d in "$AGHANIM_HOME"/projects/*/control "$AGHANIM_HOME"/projects/*/reports-wt; do
    [ -e "$d/.git" ] && { git -C "$d" worktree repair >/dev/null 2>&1 || echo "aghanim: could not relink $d (git worktree repair)" >&2; }
  done
  echo "moved $old to $AGHANIM_HOME; run 'aghanim install' and the dispatcher installer next"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install) cmd_install ;;
  doctor) cmd_doctor ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list ;;
  pool) cmd_pool "$@" ;;
  pause) cmd_pause "$@" ;;
  resume) cmd_resume "$@" ;;
  setup-board) use "${1:-}"; cd "$FACTORY_HOME/control" && exec bash "$HERE/setup-board.sh" ;;
  migrate-home) cmd_migrate_home "$@" ;;
  metrics) use "${1:-}"; exec bash "$HERE/metrics.sh" ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
