#!/usr/bin/env bash
# Minimal gh stand-in for board.sh tests. Data lives in $FAKE_GH_DIR.
d="$FAKE_GH_DIR"
[ -e "$d/fail" ] && { echo "gh: network error" >&2; exit 1; }
args="$*"
echo "$args" >> "$d/calls"
# FAKE_GH_NO_JQ: the dashboard's calls must not use --jq (gh crashes on it when Python starts it on
# Windows); they get JSON instead. board.sh's own graphql read keeps --jq.
# The dashboard's title read (GraphQL, by number): titles come from $d/titles.tsv ("number<TAB>title",
# default 7/Seven). A number not in it is a GraphQL error (exit 1) with the others still printed.
case "$args" in *issueOrPullRequest*)
  [ -n "${FAKE_GH_NO_JQ:-}" ] && case "$args" in *--jq*) echo "fake-gh: --jq not allowed here: $args" >&2; exit 99 ;; esac
  nums="$(echo "$args" | grep -o 'issueOrPullRequest(number: [0-9]*' | grep -o '[0-9]*$')"
  out=""; miss=0; sep=""
  for n in $nums; do
    t="$( { if [ -f "$d/titles.tsv" ]; then tr -d '\r' < "$d/titles.tsv"; else printf '7\tSeven\n'; fi; } | awk -F'\t' -v n="$n" '$1 == n {print $2; f=1} END {exit !f}')" || { miss=1; out="$out$sep\"i$n\":null"; sep=","; continue; }
    out="$out$sep\"i$n\":{\"title\":\"$t\"}"; sep=","
  done
  if [ "$miss" = 1 ]; then echo "{\"data\":{\"repository\":{$out}},\"errors\":[{\"message\":\"Could not resolve\"}]}"; exit 1; fi
  echo "{\"data\":{\"repository\":{$out}}}"; exit 0 ;;
esac
if [ -n "${FAKE_GH_NO_JQ:-}" ] && [[ "$args" != "api graphql"* ]]; then
  case "$args" in *--jq*) echo "fake-gh: --jq not allowed here: $args" >&2; exit 99 ;; esac
  case "$args" in
    "project view"*) echo '{"id":"PVT_x"}'; exit 0 ;;
    "project field-list"*)
      printf '{"fields":[{"name":"Status","id":"FLD_x","options":['
      i=0; sep=""; for s in "👤 Inbox" "👤 Ready for Refinement" "🤖 Technical Refinement" "👤 Spec Review" "👤 Ready for Dev" "🤖 Coding" "🤖 Validation" "👤 Staged" "👤 Ready for Prod" "🤖 Done"; do
        i=$((i+1)); printf '%s{"name":"%s","id":"opt%s"}' "$sep" "$s" "$i"; sep=","; done
      printf ']}]}\n'; exit 0 ;;
    "api repos/acme/shop/issues?labels="*) echo '[{"number":7}]'; exit 0 ;;
    "api repos/acme/shop/issues/"*"/comments"*) [ -f "$d/issue-comments" ] && { cat "$d/issue-comments"; exit 0; }; echo '[{"body":"Spec ready"},{"body":"**Validate blocked (infrastructure)**: stack down"}]'; exit 0 ;;
  esac
fi
case "$args" in
  "api graphql"*|"project item-list"*)
    awk -F'\t' '{print $2"\t"$3"\t"$1}' "$d/items.tsv" ;;
  "project view"*)
    echo "PVT_x" ;;
  "project field-list"*"| .id")
    echo "FLD_x" ;;
  "project field-list"*)
    i=0; for s in "👤 Inbox" "👤 Ready for Refinement" "🤖 Technical Refinement" "👤 Spec Review" "👤 Ready for Dev" "🤖 Coding" "🤖 Validation" "👤 Staged" "👤 Ready for Prod" "🤖 Done"; do
      i=$((i+1)); printf '%s	opt%s
' "$s" "$i"; done ;;
  "project item-edit"*)
    echo "$args" >> "$d/edits" ;;
  "api repos/acme/shop/issues?labels=blocked:infra"*)
    cat "$d/infra" 2>/dev/null ;;
  "api -X "*) ;;
  "api repos/acme/shop/issues/"*)
    [ -e "$d/fail-issue-view" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    n="$(echo "$args" | sed -E 's#.*issues/([0-9]+).*#\1#')"; if [ -f "$d/labels-$n" ]; then cat "$d/labels-$n"; fi ;;
  "issue list"*)
    echo '[{"number":7,"title":"Seven"},{"number":9,"title":"Nine"}]' ;;
  "issue view"*)
    case "$args" in *"--repo acme/shop"*) ;; *) echo "failed to run git: fatal: not a git repository" >&2; exit 1 ;; esac
    [ -e "$d/fail-issue-view" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    n="$(echo "$args" | awk '{print $3}')"; if [ -f "$d/labels-$n" ]; then cat "$d/labels-$n"; fi ;;
  "issue comment"*)
    [ -e "$d/fail-comment" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    cat >> "$d/comments" ;;
  *) echo "fake-gh: unexpected: $args" >&2; exit 9 ;;
esac
