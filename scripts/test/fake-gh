#!/usr/bin/env bash
# Minimal gh stand-in for board.sh tests. Data lives in $FAKE_GH_DIR.
d="$FAKE_GH_DIR"
[ -e "$d/fail" ] && { echo "gh: network error" >&2; exit 1; }
args="$*"
echo "$args" >> "$d/calls"
# Failure injection (#173): FAKE_GH_FAIL_AT=<n> fails the n-th call (counted in $d/fail-count);
# FAKE_GH_FAIL_CMD=<ERE> fails every call whose argv line matches. Both unset: no effect.
if [ -n "${FAKE_GH_FAIL_AT:-}" ]; then
  fc="$(cat "$d/fail-count" 2>/dev/null || true)"; fc=$(( ${fc:-0} + 1 )); echo "$fc" > "$d/fail-count"
  [ "$fc" = "$FAKE_GH_FAIL_AT" ] && { echo "gh: injected failure" >&2; exit 1; }
fi
if [ -n "${FAKE_GH_FAIL_CMD:-}" ] && printf '%s\n' "$args" | grep -Eq -- "$FAKE_GH_FAIL_CMD"; then
  echo "gh: injected failure" >&2; exit 1
fi
# FAKE_GH_NO_JQ: the dashboard's calls must not use --jq (gh crashes on it when Python starts it on
# Windows); they get JSON instead. board.sh's own graphql read keeps --jq.
# The dashboard's title read (GraphQL, by number): titles come from $d/titles.tsv ("number<TAB>title",
# default 7/Seven). A number not in it is a GraphQL error (exit 1) with the others still printed.
case "$args" in *issueOrPullRequest*)
  [ -n "${FAKE_GH_NO_JQ:-}" ] && case "$args" in *--jq*) echo "fake-gh: --jq not allowed here: $args" >&2; exit 99 ;; esac
  nums="$(echo "$args" | grep -o 'issueOrPullRequest(number: [0-9]*' | grep -o '[0-9]*$')"
  out=""; miss=0; sep=""
  for n in $nums; do
    t="$( { if [ -f "$d/titles.tsv" ]; then tr -d '\r' < "$d/titles.tsv"; else printf '7\tSeven\n'; fi; } | awk -F'\t' -v n="$n" '$1 == n {print $2 "\t" $3; f=1} END {exit !f}')" || { miss=1; out="$out$sep\"i$n\":null"; sep=","; continue; }
    at="${t#*$'\t'}"; t="${t%%$'\t'*}"  # an optional third column is the issue's createdAt
    out="$out$sep\"i$n\":{\"title\":\"$t\"${at:+,\"createdAt\":\"$at\"}}"; sep=","
  done
  if [ "$miss" = 1 ]; then echo "{\"data\":{\"repository\":{$out}},\"errors\":[{\"message\":\"Could not resolve\"}]}"; exit 1; fi
  echo "{\"data\":{\"repository\":{$out}}}"; exit 0 ;;
esac
# The dashboard's reorder (#128): recorded in $d/positions ("<item> after <item|->"), and the item moves in items.tsv,
# so the next board read has the new order. $d/fail-position makes it fail.
case "$args" in *updateProjectV2ItemPosition*)
  [ -e "$d/fail-position" ] && { echo "gh: HTTP 502" >&2; exit 1; }
  item="$(printf '%s\n' "$@" | sed -n 's/^item=//p')"; after="$(printf '%s\n' "$@" | sed -n 's/^after=//p')"
  echo "$item after ${after:--}" >> "$d/positions"
  awk -F'\t' -v i="$item" -v a="$after" '$1 == i { row = $0; next } { rows[++n] = $0; ids[n] = $1 }
    END { if (a == "") print row; for (k = 1; k <= n; k++) { print rows[k]; if (ids[k] == a) print row } }' "$d/items.tsv" > "$d/items.tsv.new" \
    && mv "$d/items.tsv.new" "$d/items.tsv"
  echo '{"data":{"updateProjectV2ItemPosition":{"clientMutationId":null}}}'; exit 0 ;;
esac
# The dispatcher's dependency read (#202): the issues a card is "Blocked by", a JSON array from $d/blocked-by-<n>
# (default []). $d/fail-deps makes it fail. Every call is logged in $d/dep-calls.
deps_read() {
  n="$(echo "$args" | sed -E 's#.*issues/([0-9]+)/dependencies.*#\1#')"
  echo "$args" >> "$d/dep-calls"
  [ -e "$d/fail-deps" ] && { echo "gh: HTTP 502" >&2; exit 1; }
  if [ -f "$d/blocked-by-$n" ]; then cat "$d/blocked-by-$n"; else echo '[]'; fi
  exit 0
}
if [ -n "${FAKE_GH_NO_JQ:-}" ] && [[ "$args" != "api graphql"* ]]; then
  case "$args" in *--jq*) echo "fake-gh: --jq not allowed here: $args" >&2; exit 99 ;; esac
  case "$args" in
    "project view"*) echo '{"id":"PVT_x"}'; exit 0 ;;
    "project field-list"*)
      printf '{"fields":[{"name":"Status","id":"FLD_x","options":['
      i=0; sep=""; for s in "👤 Inbox" "👤 Ready for Refinement" "🤖 Technical Refinement" "👤 Spec Review" "👤 Ready for Dev" "🤖 Coding" "🤖 Validation" "👤 Staged" "👤 Ready for Prod" "🤖 Done"; do
        i=$((i+1)); printf '%s{"name":"%s","id":"opt%s"}' "$sep" "$s" "$i"; sep=","; done
      printf ']}]}\n'; exit 0 ;;
    "api repos/acme/shop/issues?labels="*)  # $d/label-<label> (":" as "-") holds the issues with that label; default #7
      l="${args#*labels=}"; l="${l%%&*}"; [ -f "$d/label-${l//:/-}" ] && { cat "$d/label-${l//:/-}"; exit 0; }; echo '[{"number":7}]'; exit 0 ;;
    "api user") echo '{"login":"factory"}'; exit 0 ;;
    "api repos/acme/shop/issues/"*"/events"*)  # $d/events-<n>, a JSON array (default [])
      n="$(echo "$args" | sed -E 's#.*issues/([0-9]+)/.*#\1#')"; [ -f "$d/events-$n" ] && { cat "$d/events-$n"; exit 0; }; echo '[]'; exit 0 ;;
    "api repos/acme/shop/issues/"*"/comments"*)  # $d/comments-<n> for one card, else $d/issue-comments for all
      n="$(echo "$args" | sed -E 's#.*issues/([0-9]+)/.*#\1#')"; [ -f "$d/comments-$n" ] && { cat "$d/comments-$n"; exit 0; }
      [ -f "$d/issue-comments" ] && { cat "$d/issue-comments"; exit 0; }; echo '[{"body":"Spec ready"},{"body":"**Validate blocked (infrastructure)**: stack down"}]'; exit 0 ;;
    "api repos/acme/shop/issues/"*"/dependencies/blocked_by"*) deps_read ;;
    "api repos/acme/shop/issues/"*)  # one issue: its labels from $d/labels-<n>, one name a line
      [ -e "$d/fail-issue-view" ] && { echo "gh: HTTP 502" >&2; exit 1; }
      n="$(echo "$args" | sed -E 's#.*issues/([0-9]+).*#\1#')"; printf '{"number":%s,"labels":[' "$n"; sep=""
      [ -f "$d/labels-$n" ] && while IFS= read -r l; do [ -n "$l" ] && printf '%s{"name":"%s"}' "$sep" "${l%$'\r'}" && sep=","; done < "$d/labels-$n"
      printf ']}\n'; exit 0 ;;
  esac
fi
case "$args" in
  "api graphql"*|"project item-list"*)
    awk -F'\t' '{print $2"\t"$3"\t"$1}' "$d/items.tsv" ;;
  "project view"*)
    echo "PVT_x" ;;
  "project field-list"*"| .id")
    echo "FLD_x" ;;
  "project field-list"*)
    i=0; for s in "👤 Inbox" "👤 Ready for Refinement" "🤖 Technical Refinement" "👤 Spec Review" "👤 Ready for Dev" "🤖 Coding" "🤖 Validation" "👤 Staged" "👤 Ready for Prod" "🤖 Done"; do
      i=$((i+1)); printf '%s	opt%s
' "$s" "$i"; done ;;
  "project item-edit"*)
    echo "$args" >> "$d/edits" ;;
  "api repos/acme/shop/issues?labels=blocked:infra"*)
    cat "$d/infra" 2>/dev/null ;;
  "api -X "*) ;;
  "api repos/acme/shop/issues/"*"/dependencies/blocked_by"*) deps_read ;;
  "api repos/acme/shop/issues/"*)
    [ -e "$d/fail-issue-view" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    n="$(echo "$args" | sed -E 's#.*issues/([0-9]+).*#\1#')"; if [ -f "$d/labels-$n" ]; then cat "$d/labels-$n"; fi ;;
  "api user"*) echo factory ;;
  "issue view"*"--json number,title,body,comments"*)
    n="$(echo "$args" | awk '{print $3}')"; cat "$d/issue-$n.json" ;;
  "issue list"*)
    echo '[{"number":7,"title":"Seven"},{"number":9,"title":"Nine"}]' ;;
  "issue view"*)
    case "$args" in *"--repo acme/shop"*) ;; *) echo "failed to run git: fatal: not a git repository" >&2; exit 1 ;; esac
    [ -e "$d/fail-issue-view" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    n="$(echo "$args" | awk '{print $3}')"; if [ -f "$d/labels-$n" ]; then cat "$d/labels-$n"; fi ;;
  "pr list"*)  # the open pull requests, as JSON, from $d/prs (default: none)
    if [ -f "$d/prs" ]; then cat "$d/prs"; else echo '[]'; fi ;;
  "pr close"*)  # recorded in $d/pr-closed; $d/fail-pr-close makes it fail
    [ -e "$d/fail-pr-close" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    echo "$args" >> "$d/pr-closed" ;;
  "issue comment"*)
    [ -e "$d/fail-comment" ] && { echo "gh: HTTP 502" >&2; exit 1; }
    cat >> "$d/comments" ;;
  *) echo "fake-gh: unexpected: $args" >&2; exit 9 ;;
esac
