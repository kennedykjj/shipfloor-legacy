#!/usr/bin/env bash
# gh stand-in for deploy.sh tests. State in $FG: remote (bare repo), pr, branch, comments ("author<TAB>line"),
# ci ("name=STATE,..."), prhead (overrides the PR head), merged (merge sha), no-pr, calls, labels.
d="$FG"; args="$*"; echo "$args" >> "$d/calls"
remote="$(cat "$d/remote")"; pr="$(cat "$d/pr")"; branch="$(cat "$d/branch")"
head() { if [ -e "$d/prhead" ]; then cat "$d/prhead"; else git --git-dir="$remote" rev-parse "refs/heads/$branch" 2>/dev/null; fi; }
case "$args" in
  "api user"*) echo factory ;;
  "pr list"*"--state open"*) [ -e "$d/no-pr" ] || [ -e "$d/merged" ] || printf '%s\t%s\tfalse\t%s\n' "$pr" "$branch" "$(head)" ;;
  "pr list"*"--state merged"*) if [ -e "$d/merged" ]; then printf '%s\t%s\t%s\n' "$pr" "$branch" "$(cat "$d/merged")"; fi ;;
  "pr view $pr"*"headRefOid,statusCheckRollup"*) printf '%s %s\n' "$(head)" "$(cat "$d/ci")" ;;
  "pr view $pr"*"mergeCommit"*) cat "$d/merged" 2>/dev/null ;;
  "pr view $pr"*"--json state"*) [ -e "$d/merged" ] && echo MERGED || echo OPEN ;;
  "pr view $pr"*"headRefOid"*) head ;;
  "issue view"*) who="$(printf '%s' "$args" | sed -n 's/.*login == "\([^"]*\)".*/\1/p')"
    awk -F'\t' -v w="$who" 'w == "" || $1 == w { print $2 }' "$d/comments" 2>/dev/null ;;
  "issue comment"*) body="${args#*--body }"; printf '%s\n' "$body" | sed 's/^/factory\t/' >> "$d/comments" ;;
  "issue edit"*"--add-label blocked"*) echo blocked >> "$d/labels" ;;
  "issue reopen"*) echo reopened >> "$d/labels" ;;
  "pr merge $pr"*)
    want="${args##*--match-head-commit }"; want="${want%% *}"
    [ "$want" = "$(head)" ] || { echo "head moved" >&2; exit 1; }
    w="$(mktemp -d)"; git clone -q "$remote" "$w"; git -C "$w" config user.email t@t; git -C "$w" config user.name t
    git -C "$w" merge -q --squash "origin/$branch" >/dev/null && git -C "$w" commit -qm "squash #$pr" && git -C "$w" push -q origin HEAD:main
    git -C "$w" rev-parse HEAD > "$d/merged" ;;
  "pr create"*) echo "https://github.com/acme/shop/pull/999" ;;
  "run rerun "*) id="${args#run rerun }"; id="${id%% *}"; [ -e "$d/rerun-$id" ] && cp "$d/rerun-$id" "$d/concl-$id" ;;  # rerun-<id>: what the rerun concludes
  "run list"*"conclusion"*) ;;  # the failed runs of a commit: none
  "run list"*) sha="${args##*--commit }"; sha="${sha%% *}"; cat "$d/run-$sha" 2>/dev/null ;;  # run-<sha>: the run id
  "run view "*) id="${args#run view }"; id="${id%% *}"; cat "$d/concl-$id" 2>/dev/null ;;      # concl-<id>: "completed success"
  *) echo "fake-gh-deploy: unexpected: $args" >&2; exit 9 ;;
esac
